# ── Doppler (RECOMMENDED — no .env file needed) ─────────────────
# Option A: Set a Doppler service token and the app fetches secrets directly
DOPPLER_TOKEN=dp.st.your_service_token_here
DOPPLER_PROJECT=tiktok-scraper
DOPPLER_CONFIG=dev

# Option B: Install Doppler CLI and run `doppler setup` in this directory
#   brew install dopplerhq/cli/doppler   (macOS)
#   curl -Ls https://cli.doppler.com/install.sh | sh   (Linux)
#   doppler login
#   doppler setup
#   python main.py  (secrets are auto-fetched via CLI)

# ── Fallback (.env) ─────────────────────────────────────────────
# Only needed if Doppler is not configured
# PORT=5000
# APIFY_API_TOKEN=
# SMARTLEAD_API_KEY=
# FIND_EMAIL_API_KEY=
# FIND_EMAIL_BASE_URL=https://app.findymail.com/api
# KEYWORDS_EVERYWHERE_API_KEY=
# PHANTOMBUSTER_API_KEY=
